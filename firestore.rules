rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Performance-optimized admin check using UID and email
    function isFastAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'XaJrcf366oPDaeqJkAFtWSiyuJ03' ||
        ('email' in request.auth.token && (
          request.auth.token.email in [
            'academy.masartamayoz@gmail.com',
            'masartamayoz@gmail.com',
            'centrekhawarizmi2020@gmail.com',
            'admin@admin.com'
          ] ||
          request.auth.token.email.matches('(?i)^(academy\\.masartamayoz@gmail\\.com|masartamayoz@gmail\\.com|centrekhawarizmi2020@gmail\\.com|admin@admin\\.com)$')
        ))
      );
    }

    function isAdmin() {
      return isFastAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userType', '') == 'admin'
      );
    }

    function isTeacher() {
      return isFastAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userType', '') == 'teacher'
      );
    }

    function isParent() {
      return isFastAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userType', '') == 'parent'
      );
    }

    function isParentOf(childId) {
      return isSignedIn() && exists(/databases/$(database)/documents/parentChildren/$(request.auth.uid + '_' + childId));
    }

    function isMeSubscribed() {
      return isFastAdmin() || 
             isAdmin() || 
             isTeacher() || 
             (isSignedIn() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('subscriptionStatus', 'inactive') == 'active');
    }

    function isChildSubscribed(childId) {
      return isParentOf(childId) && 
             exists(/databases/$(database)/documents/users/$(childId)) && 
             get(/databases/$(database)/documents/users/$(childId)).data.get('subscriptionStatus', 'inactive') == 'active';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 2. Collection Rules

    // Global Admin Escape Hatch
    match /{allCollections=**} {
      allow read, write: if isFastAdmin() || isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() && (isFastAdmin() || isAdmin() || isOwner(userId));
      allow delete: if isFastAdmin() || isAdmin();
    }

    // Wallets
    match /wallets/{userId} {
      allow read: if isFastAdmin() || isAdmin() || isOwner(userId) || isParentOf(userId);
      allow write: if isFastAdmin() || isAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isFastAdmin() || 
        isAdmin() || 
        isTeacher() ||
        (resource.data.userId == request.auth.uid && isMeSubscribed()) || 
        (isParentOf(resource.data.userId) && isChildSubscribed(resource.data.userId))
      );
      allow create: if isSignedIn() && (isFastAdmin() || isAdmin() || isTeacher() || isMeSubscribed());
      allow update, delete: if isFastAdmin() || isAdmin();
    }

    // Groups Collection
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isFastAdmin() || isAdmin();
    }

    // Videos Collection
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow write: if isFastAdmin() || isAdmin();
    }

    // Receipts Collection
    match /receipts/{receiptId} {
      allow read: if isFastAdmin() || isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.parentId == request.auth.uid));
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.parentId == request.auth.uid);
      allow update, delete: if isFastAdmin() || isAdmin();
    }

    // Payout Requests
    match /payoutRequests/{requestId} {
      allow read: if isFastAdmin() || isAdmin() || (isSignedIn() && resource.data.teacherId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isFastAdmin() || isAdmin();
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if isSignedIn() && (isFastAdmin() || isAdmin() || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isFastAdmin() || isAdmin() || (resource.data.recipientId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])));
      allow delete: if isFastAdmin() || isAdmin();
    }

    // Teacher Sessions
    match /teacherSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() || isFastAdmin() || isAdmin();
      allow update: if isFastAdmin() || isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow delete: if isFastAdmin() || isAdmin();
    }

    // Parent-Child links
    match /parentChildren/{linkId} {
      allow read: if isSignedIn() && (isFastAdmin() || isAdmin() || resource.data.parentId == request.auth.uid || resource.data.childId == request.auth.uid);
      allow create: if isSignedIn() && (isFastAdmin() || isAdmin() || request.resource.data.parentId == request.auth.uid);
      allow update: if isFastAdmin() || isAdmin() || (isSignedIn() && resource.data.parentId == request.auth.uid);
      allow delete: if isFastAdmin() || isAdmin() || (isSignedIn() && resource.data.parentId == request.auth.uid);
    }

    // Transactions Collection (Legacy/Supporting)
    match /transactions/{transactionId} {
      allow read: if isFastAdmin() || isAdmin() || (isSignedIn() && (resource.data.parentId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow write: if isFastAdmin() || isAdmin();
    }

    // Content Access Rules Collection
    match /contentAccessRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isFastAdmin() || isAdmin();
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isFastAdmin() || isAdmin();
    }

    // Connectivity Test
    match /test/connection {
      allow read, write: if true;
    }
  }
}
